<Window x:Class="vba_brain.UI.WPF.Views.FLoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="Login"
        Background="#FFFFFF"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Section: section -->
        <Grid x:Name="sec_section" Width="333" Height="180" Background="Transparent" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Label x:Name="lblLoginID"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,0"
                   VerticalAlignment="Top"
                   Width="100"
                   Height="20"
                   Content="Login ID:"
                   Padding="0"
                   FontFamily="Segoe UI"
                   FontSize="16" />
            <TextBox x:Name="txtID"
                     HorizontalAlignment="Left"
                     Margin="105,0,0,0"
                     VerticalAlignment="Top"
                     Width="200"
                     Height="20"
                     Text="{Binding TxtID}"
                     Padding="0"
                     VerticalContentAlignment="Center"
                     BorderBrush="#C0C0C0"
                     BorderThickness="1"
                     IsReadOnly="True" />
            <Label x:Name="lblPassword"
                   HorizontalAlignment="Left"
                   Margin="0,25,0,0"
                   VerticalAlignment="Top"
                   Width="100"
                   Height="20"
                   Content="Password:"
                   Padding="0"
                   FontFamily="Segoe UI"
                   FontSize="16" />
            <PasswordBox x:Name="txtPass"
                         HorizontalAlignment="Left"
                         Margin="105,25,0,0"
                         VerticalAlignment="Top"
                         Width="200"
                         Height="20"
                         Padding="0"
                         VerticalContentAlignment="Center"
                         PasswordChanged="PasswordBox_PasswordChanged"
                         BorderBrush="#C0C0C0"
                         BorderThickness="1">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding F003Command}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </PasswordBox>
            <Button x:Name="cmdLogin"
                    HorizontalAlignment="Left"
                    Margin="105,50,0,0"
                    VerticalAlignment="Top"
                    Width="100"
                    Height="30"
                    Content="Login"
                    Padding="0"
                    Command="{Binding F010Command}"
                    Visibility="Collapsed" />
            <Button x:Name="cmdClose"
                    HorizontalAlignment="Left"
                    Margin="220,50,0,0"
                    VerticalAlignment="Top"
                    Width="85"
                    Height="30"
                    Content="Close"
                    Padding="0"
                    Command="{Binding F011Command}" />
            <!-- macro.A_メニューバーを表示 -->
            <Label x:Name="lblStoreInfo"
                   HorizontalAlignment="Left"
                   Margin="10,85,0,0"
                   VerticalAlignment="Top"
                   Width="300"
                   Height="25"
                   Content="New After Sales DB"
                   Padding="0"
                   FontSize="21"
                   FontWeight="Bold">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding F012Command}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Label>
            <!-- macro.A_メニューバーを表示, macro.M300_Splash(M)を開く -->
            <Label x:Name="lblMenuTrigger"
                   HorizontalAlignment="Left"
                   Margin="0,115,0,0"
                   VerticalAlignment="Top"
                   Width="0"
                   Height="0"
                   Content=" "
                   Padding="0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding F013Command}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding F014Command}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Label>
            <Label x:Name="lblAutoRetrieve"
                   HorizontalAlignment="Left"
                   Margin="10,145,0,0"
                   VerticalAlignment="Top"
                   Width="200"
                   Height="20"
                   Content="*Auto-retrieved from PC"
                   Padding="0"
                   FontSize="13"
                   Foreground="#666666" />
            <Label x:Name="lblOpenPasswordTable"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,0"
                   VerticalAlignment="Top"
                   Width="0"
                   Height="0"
                   Content=" "
                   Padding="0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding F015Command}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Label>
            <Label x:Name="lblEndProcess"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,0"
                   VerticalAlignment="Top"
                   Width="0"
                   Height="0"
                   Content=" "
                   Padding="0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding F016Command}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Label>
            <Label x:Name="lblVersion"
                   HorizontalAlignment="Left"
                   Margin="250,155,0,0"
                   VerticalAlignment="Top"
                   Width="80"
                   Height="20"
                   Content="Ver 2025/06/30"
                   Padding="0"
                   FontSize="13"
                   Foreground="#666666" />
            <TextBox x:Name="txtReleasedDate"
                     HorizontalAlignment="Left"
                     Margin="105,75,0,0"
                     VerticalAlignment="Top"
                     Width="200"
                     Height="20"
                     Text="{Binding Comment1}"
                     Padding="0"
                     VerticalContentAlignment="Center"
                     BorderBrush="#C0C0C0"
                     BorderThickness="1"
                     IsReadOnly="True" />
        </Grid>
    </Grid>
</Window>
