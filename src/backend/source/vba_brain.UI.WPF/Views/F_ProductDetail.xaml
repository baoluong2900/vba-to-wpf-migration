<Window x:Class="vba_brain.UI.WPF.Views.F_ProductDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="Chi tiết sản phẩm"
        Background="#FFFFFF"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Section: section -->
        <Grid x:Name="sec_section" Width="333" Height="180" Background="Transparent" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBox x:Name="txtProductID"
                     HorizontalAlignment="Left"
                     Margin="0,0,0,0"
                     VerticalAlignment="Top"
                     Text="{Binding TxtProductID}"
                     Padding="0"
                     VerticalContentAlignment="Center"
                     IsReadOnly="True" />
            <TextBox x:Name="txtProductName"
                     HorizontalAlignment="Left"
                     Margin="0,0,0,0"
                     VerticalAlignment="Top"
                     Text="{Binding TxtProductName}"
                     Padding="0"
                     VerticalContentAlignment="Center" />
            <ComboBox x:Name="cboSupplier"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,0"
                      VerticalAlignment="Top"
                      Padding="0" />
            <TextBlock x:Name="optStatus"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,0"
                       VerticalAlignment="Top" />
            <RadioButton x:Name="optActive"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,0"
                         VerticalAlignment="Top"
                         Width="100"
                         Height="20" />
            <RadioButton x:Name="optInactive"
                         HorizontalAlignment="Left"
                         Margin="0,25,0,0"
                         VerticalAlignment="Top"
                         Width="100"
                         Height="20" />
            <CheckBox x:Name="chkDiscontinued"
                      HorizontalAlignment="Left"
                      Margin="0,50,0,0"
                      VerticalAlignment="Top"
                      Width="150"
                      Height="20" />
            <Button x:Name="btnSave"
                    HorizontalAlignment="Left"
                    Margin="0,75,0,0"
                    VerticalAlignment="Top"
                    Width="75"
                    Height="25"
                    Content="Save"
                    Padding="0"
                    Command="{Binding F001Command}" />
            <Button x:Name="btnDelete"
                    HorizontalAlignment="Left"
                    Margin="80,75,0,0"
                    VerticalAlignment="Top"
                    Width="75"
                    Height="25"
                    Content="Delete"
                    Padding="0"
                    Command="{Binding F002Command}" />
        </Grid>
    </Grid>
</Window>
