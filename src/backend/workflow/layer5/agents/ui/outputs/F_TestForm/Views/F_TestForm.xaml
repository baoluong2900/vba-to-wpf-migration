<Window x:Class="vba_brain.UI.WPF.Views.F_TestForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title=""
        Background="#FFFFFF"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Section: section -->
        <Grid x:Name="sec_section" Width="333" Height="0" Background="Transparent" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBox x:Name="txtUserName"
                     HorizontalAlignment="Left"
                     Margin="0,0,0,0"
                     VerticalAlignment="Top"
                     Text="{Binding TxtUserName}"
                     Padding="0"
                     VerticalContentAlignment="Center">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding F001Command}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBox>
            <Button x:Name="btnSubmit"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,0"
                    VerticalAlignment="Top"
                    Content=""
                    Padding="0"
                    Command="{Binding F002Command}" />
        </Grid>
    </Grid>
</Window>
