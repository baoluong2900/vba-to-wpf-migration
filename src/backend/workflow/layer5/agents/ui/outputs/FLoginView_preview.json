{
  "window": {
    "class": "vba_brain.UI.WPF.Views.F_Login",
    "title": "Login",
    "width": null,
    "height": null,
    "background": "#FFFFFF",
    "window_style": "SingleBorderWindow",
    "resize_mode": "CanResize",
    "show_in_taskbar": false,
    "topmost": true,
    "allows_transparency": true,
    "startup_location": "CenterScreen"
  },
  "controls": [
    {
      "type": "Section",
      "name": "section",
      "margin_left": 0,
      "margin_top": 0,
      "width": 333,
      "height": 180,
      "background": "Transparent",
      "controls": [
        {
          "type": "Label",
          "name": "lblLoginID",
          "margin_left": 0,
          "margin_top": 0,
          "width": 100,
          "height": 20,
          "content": "Login ID:",
          "font_family": "Segoe UI",
          "font_size": 12
        },
        {
          "type": "TextBox",
          "name": "txtID",
          "margin_left": 105,
          "margin_top": 0,
          "width": 200,
          "height": 20,
          "binding": "TxtID",
          "is_readonly": true,
          "border_brush": "#C0C0C0"
        },
        {
          "type": "Label",
          "name": "lblPassword",
          "margin_left": 0,
          "margin_top": 25,
          "width": 100,
          "height": 20,
          "content": "Password:",
          "font_family": "Segoe UI",
          "font_size": 12
        },
        {
          "type": "PasswordBox",
          "name": "txtPass",
          "margin_left": 105,
          "margin_top": 25,
          "width": 200,
          "height": 20,
          "password_event": true,
          "border_brush": "#C0C0C0"
        },
        {
          "type": "Button",
          "name": "cmdLogin",
          "margin_left": 105,
          "margin_top": 50,
          "width": 100,
          "height": 30,
          "content": "Login",
          "command": "F010Command",
          "visible": false
        },
        {
          "type": "Button",
          "name": "cmdClose",
          "margin_left": 220,
          "margin_top": 50,
          "width": 85,
          "height": 30,
          "content": "Close",
          "command": "F011Command"
        },
        {
          "type": "Label",
          "name": "lblStoreInfo",
          "margin_left": 10,
          "margin_top": 85,
          "width": 300,
          "height": 25,
          "content": "New After Sales DB",
          "font_size": 16,
          "font_weight": "Bold",
          "comment": "macro.A_メニューバーを表示"
        },
        {
          "type": "Label",
          "name": "lblMenuTrigger",
          "margin_left": 0,
          "margin_top": 115,
          "width": 0,
          "height": 0,
          "content": " ",
          "command": "F012Command",
          "comment": "macro.A_メニューバーを表示, macro.M300_Splash(M)を開く"
        },
        {
          "type": "Label",
          "name": "lblAutoRetrieve",
          "margin_left": 10,
          "margin_top": 145,
          "width": 200,
          "height": 20,
          "content": "*Auto-retrieved from PC",
          "font_size": 10,
          "foreground": "#666666"
        },
        {
          "type": "Label",
          "name": "lblOpenPasswordTable",
          "margin_left": 0,
          "margin_top": 0,
          "width": 0,
          "height": 0,
          "content": " ",
          "command": "F013Command"
        },
        {
          "type": "Label",
          "name": "lblEndProcess",
          "margin_left": 0,
          "margin_top": 0,
          "width": 0,
          "height": 0,
          "content": " ",
          "command": "F014Command"
        },
        {
          "type": "Label",
          "name": "lblVersion",
          "margin_left": 250,
          "margin_top": 155,
          "width": 80,
          "height": 20,
          "content": "Ver 2025/06/30",
          "font_size": 10,
          "foreground": "#666666"
        },
        {
          "type": "TextBox",
          "name": "txtReleasedDate",
          "margin_left": 105,
          "margin_top": 75,
          "width": 200,
          "height": 20,
          "binding": "Comment1",
          "is_readonly": true,
          "border_brush": "#C0C0C0"
        }
      ]
    }
  ]
}