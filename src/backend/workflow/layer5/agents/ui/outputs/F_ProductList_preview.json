{
  "window": {
    "class": "vba_brain.UI.WPF.Views.F_ProductList",
    "title": "Danh sách sản phẩm",
    "width": null,
    "height": null,
    "background": "#FFFFFF",
    "window_style": "SingleBorderWindow",
    "resize_mode": "CanResize",
    "show_in_taskbar": false,
    "topmost": true,
    "allows_transparency": true,
    "startup_location": "CenterScreen"
  },
  "controls": [
    {
      "type": "Section",
      "name": "section",
      "margin_left": 0,
      "margin_top": 0,
      "width": 333,
      "height": 0,
      "background": "Transparent",
      "controls": [
        {
          "type": "TextBox",
          "name": "txtSearch",
          "margin_left": 0,
          "margin_top": 0,
          "width": 100,
          "height": 20,
          "binding": "TxtSearch"
        },
        {
          "type": "ListBox",
          "name": "lstCategory",
          "margin_left": 0,
          "margin_top": 0,
          "width": 100,
          "height": 50,
          "binding": "LstCategory"
        },
        {
          "type": "TextBlock",
          "name": "subProductGrid",
          "margin_left": 0,
          "margin_top": 0,
          "width": 100,
          "height": 20,
          "text": "subProductGrid",
          "foreground": "#000000"
        },
        {
          "type": "Button",
          "name": "btnOpenDetail",
          "margin_left": 0,
          "margin_top": 0,
          "width": 75,
          "height": 23,
          "content": "btnOpenDetail",
          "command": "F002Command"
        }
      ]
    }
  ]
}