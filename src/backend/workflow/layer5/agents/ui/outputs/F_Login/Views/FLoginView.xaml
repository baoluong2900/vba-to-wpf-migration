<Window x:Class="vba_brain.UI.WPF.Views.FLoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="ログイン"
        Background="#FFFFFF"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Section: 詳細 -->
        <Grid x:Name="sec_詳細" Width="333" Height="185" Background="#E2F0D9" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Label x:Name="ログインID"
                   HorizontalAlignment="Left"
                   Margin="54,62,0,0"
                   HorizontalContentAlignment="Right"
                   VerticalAlignment="Top"
                   Width="86"
                   Height="18"
                   Content="ログインID:"
                   Padding="0"
                   FontFamily="ＭＳ Ｐゴシック"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="#000000" />
            <TextBox x:Name="txtID"
                     HorizontalAlignment="Left"
                     Margin="146,62,0,0"
                     TextAlignment="Center"
                     VerticalAlignment="Top"
                     Width="113"
                     Height="18"
                     Text="{Binding TxtID}"
                     Padding="0"
                     VerticalContentAlignment="Center"
                     FontFamily="ＭＳ Ｐゴシック"
                     FontSize="15"
                     BorderBrush="#C0C0C0"
                     BorderThickness="1"
                     IsReadOnly="True" />
            <Label x:Name="パスワード"
                   HorizontalAlignment="Left"
                   Margin="57,102,0,0"
                   HorizontalContentAlignment="Right"
                   VerticalAlignment="Top"
                   Width="81"
                   Height="18"
                   Content="パスワード:"
                   Padding="0"
                   FontFamily="ＭＳ Ｐゴシック"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="#000000" />
            <PasswordBox x:Name="txtPass"
                         HorizontalAlignment="Left"
                         Margin="146,102,0,0"
                         HorizontalContentAlignment="Center"
                         VerticalAlignment="Top"
                         Width="113"
                         Height="18"
                         Padding="0"
                         VerticalContentAlignment="Center"
                         PasswordChanged="PasswordBox_PasswordChanged"
                         FontFamily="ＭＳ Ｐゴシック"
                         FontSize="15"
                         BorderBrush="#C0C0C0"
                         BorderThickness="1">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding F003Command}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </PasswordBox>
            <Button x:Name="cmdLogin"
                    HorizontalAlignment="Left"
                    Margin="147,121,0,0"
                    VerticalAlignment="Top"
                    Width="113"
                    Height="29"
                    Content="ログイン"
                    Padding="0"
                    Command="{Binding LoginCommand}"
                    FontFamily="ＭＳ Ｐゴシック"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="#FF000000"
                    Visibility="Collapsed" />
            <Button x:Name="閉じる"
                    HorizontalAlignment="Left"
                    Margin="299,4,0,0"
                    VerticalAlignment="Top"
                    Width="30"
                    Height="30"
                    Padding="0"
                    Command="{Binding F004Command}"
                    BorderBrush="#BFBFBF"
                    BorderThickness="1">
                <Image Source="/Resources/img/F_Login/終了.bmp" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Button>
            <!-- macro.A_メニューバーを表示 -->
            <Label x:Name="施工店情報"
                   HorizontalAlignment="Left"
                   Margin="72,10,0,0"
                   VerticalAlignment="Top"
                   Width="189"
                   Height="23"
                   Content="新アフター管理DB"
                   Padding="0"
                   FontFamily="Calibri"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#3F3F3F"
                   BorderBrush="#FFFFFF"
                   BorderThickness="1">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding F005Command}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Label>
            <!-- macro.A_メニューバーを表示 -->
            <Label x:Name="ラベル142"
                   HorizontalAlignment="Left"
                   Margin="158,15,0,0"
                   VerticalAlignment="Top"
                   Width="25"
                   Height="15"
                   Content=" "
                   Padding="0"
                   FontFamily="ＭＳ Ｐゴシック"
                   FontSize="12"
                   Foreground="#C0C0C0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding F006Command}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding F007Command}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Label>
            <Label x:Name="ラベル7"
                   HorizontalAlignment="Left"
                   Margin="227,80,0,0"
                   HorizontalContentAlignment="Right"
                   VerticalAlignment="Top"
                   Width="98"
                   Height="13"
                   Content="※PCより自動取得"
                   Padding="0"
                   FontFamily="ＭＳ Ｐゴシック"
                   FontSize="11" />
            <Label x:Name="パスワードテーブルを開く"
                   HorizontalAlignment="Left"
                   Margin="57,102,0,0"
                   VerticalAlignment="Top"
                   Width="26"
                   Height="18"
                   Content=" "
                   Padding="0"
                   FontFamily="ＭＳ Ｐゴシック"
                   FontSize="12"
                   Foreground="#C0C0C0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding F008Command}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Label>
            <Label x:Name="プロセス終了"
                   HorizontalAlignment="Left"
                   Margin="242,14,0,0"
                   VerticalAlignment="Top"
                   Width="18"
                   Height="14"
                   Content=" "
                   Padding="0"
                   FontFamily="ＭＳ Ｐゴシック"
                   FontSize="12"
                   Foreground="#C0C0C0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding F009Command}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Label>
            <Label x:Name="ラベル400"
                   HorizontalAlignment="Left"
                   Margin="5,151,0,0"
                   VerticalAlignment="Top"
                   Width="108"
                   Height="23"
                   Content="2025/06/30公開Ver"
                   Padding="0"
                   FontFamily="ＭＳ Ｐゴシック"
                   FontSize="11" />
            <TextBox x:Name="最新版公開日"
                     HorizontalAlignment="Left"
                     Margin="0,161,0,0"
                     VerticalAlignment="Top"
                     Width="105"
                     Height="14"
                     Text="{Binding Comment1}"
                     Padding="0"
                     VerticalContentAlignment="Center"
                     FontFamily="Calibri"
                     FontSize="11"
                     Foreground="#ED1C24"
                     BorderBrush="#A6A6A6"
                     BorderThickness="1"
                     IsReadOnly="True" />
        </Grid>
    </Grid>
</Window>
