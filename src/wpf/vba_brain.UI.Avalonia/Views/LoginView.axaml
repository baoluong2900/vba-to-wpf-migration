<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:vba_brain.UI.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="vba_brain.UI.Avalonia.Views.LoginView"
             x:DataType="vm:LoginViewModel">
    
    <Grid Background="#11111B">
        <!-- Glassmorphism-style Login Card -->
        <Border Background="#181825"
                BorderBrush="#313244"
                BorderThickness="1"
                CornerRadius="12"
                Width="380"
                Height="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            
            <StackPanel Margin="35" VerticalAlignment="Center" Spacing="15">
                <TextBlock Text="System Login" 
                           Foreground="#CDD6F4" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10"/>
                
                <StackPanel Spacing="5">
                    <TextBlock Text="Username" Foreground="#A6ADC8" FontSize="13" FontWeight="Medium"/>
                    <TextBox Text="{Binding Username}" 
                             PlaceholderText="Enter username" 
                             Height="40" 
                             VerticalContentAlignment="Center"
                             Background="#1E1E2E" 
                             Foreground="#CDD6F4" 
                             BorderBrush="#313244"
                             CornerRadius="6"/>
                </StackPanel>
                
                <StackPanel Spacing="5">
                    <TextBlock Text="Password" Foreground="#A6ADC8" FontSize="13" FontWeight="Medium"/>
                    <TextBox Text="{Binding Password}" 
                             PasswordChar="*" 
                             PlaceholderText="Enter password" 
                             Height="40" 
                             VerticalContentAlignment="Center"
                             Background="#1E1E2E" 
                             Foreground="#CDD6F4" 
                             BorderBrush="#313244"
                             CornerRadius="6"/>
                </StackPanel>
                
                <!-- Error Message Container -->
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#F38BA8" 
                           FontSize="12" 
                           HorizontalAlignment="Center" 
                           TextWrapping="Wrap" 
                           Height="18"/>
                
                <Button Command="{Binding LoginCommand}"
                        Content="Sign In"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Height="42"
                        Background="#89B4FA"
                        Foreground="#11111B"
                        FontWeight="Bold"
                        CornerRadius="6"
                        IsEnabled="{Binding !IsBusy}"/>
                
                <ProgressBar IsIndeterminate="True" 
                             Height="4" 
                             IsVisible="{Binding IsBusy}" 
                             Foreground="#89B4FA" 
                             Background="Transparent"
                             Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
