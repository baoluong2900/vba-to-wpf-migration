<Window x:DataType="vm:FLoginViewModel" x:Class="vba_brain.UI.Avalonia.Views.FLoginView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:vba_brain.UI.Avalonia.ViewModels"
        Title="Login"
        Background="#FFFFFF"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Section: section -->
        <Grid x:Name="sec_section" Width="333" Height="180" Background="Transparent" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Label x:Name="lblLoginID"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,0"
                   VerticalAlignment="Top"
                   Width="100"
                   Height="20"
                   Content="Login ID:"
                   Padding="0"
                   FontFamily="Segoe UI"
                   FontSize="16" />
            <TextBox x:Name="txtID"
                     HorizontalAlignment="Left"
                     Margin="105,0,0,0"
                     VerticalAlignment="Top"
                     Width="200"
                     Height="20"
                     Text="{Binding TxtID}"
                     Padding="0"
                     VerticalContentAlignment="Center"
                     BorderBrush="#C0C0C0"
                     BorderThickness="1"
                     IsReadOnly="True" />
            <Label x:Name="lblPassword"
                   HorizontalAlignment="Left"
                   Margin="0,25,0,0"
                   VerticalAlignment="Top"
                   Width="100"
                   Height="20"
                   Content="Password:"
                   Padding="0"
                   FontFamily="Segoe UI"
                   FontSize="16" />
            <TextBox PasswordChar="*" x:Name="txtPass"
                         HorizontalAlignment="Left"
                         Margin="105,25,0,0"
                         VerticalAlignment="Top"
                         Width="200"
                         Height="20"
                         Padding="0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#C0C0C0"
                         BorderThickness="1">
            </TextBox>
            <Button x:Name="cmdLogin"
                    HorizontalAlignment="Left"
                    Margin="105,50,0,0"
                    VerticalAlignment="Top"
                    Width="100"
                    Height="30"
                    Content="Login"
                    Padding="0"
                    Command="{Binding F010Command}"
                    IsVisible="False" />
            <Button x:Name="cmdClose"
                    HorizontalAlignment="Left"
                    Margin="220,50,0,0"
                    VerticalAlignment="Top"
                    Width="85"
                    Height="30"
                    Content="Close"
                    Padding="0"
                    Command="{Binding F011Command}" />
            <!-- macro.A_メニューバーを表示 -->
            <Label x:Name="lblStoreInfo"
                   HorizontalAlignment="Left"
                   Margin="10,85,0,0"
                   VerticalAlignment="Top"
                   Width="300"
                   Height="25"
                   Content="New After Sales DB"
                   Padding="0"
                   FontSize="21"
                   FontWeight="Bold">
            </Label>
            <!-- macro.A_メニューバーを表示, macro.M300_Splash(M)を開く -->
            <Label x:Name="lblMenuTrigger"
                   HorizontalAlignment="Left"
                   Margin="0,115,0,0"
                   VerticalAlignment="Top"
                   Width="0"
                   Height="0"
                   Content=" "
                   Padding="0">
            </Label>
            <Label x:Name="lblAutoRetrieve"
                   HorizontalAlignment="Left"
                   Margin="10,145,0,0"
                   VerticalAlignment="Top"
                   Width="200"
                   Height="20"
                   Content="*Auto-retrieved from PC"
                   Padding="0"
                   FontSize="13"
                   Foreground="#666666" />
            <Label x:Name="lblOpenPasswordTable"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,0"
                   VerticalAlignment="Top"
                   Width="0"
                   Height="0"
                   Content=" "
                   Padding="0">
            </Label>
            <Label x:Name="lblEndProcess"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,0"
                   VerticalAlignment="Top"
                   Width="0"
                   Height="0"
                   Content=" "
                   Padding="0">
            </Label>
            <Label x:Name="lblVersion"
                   HorizontalAlignment="Left"
                   Margin="250,155,0,0"
                   VerticalAlignment="Top"
                   Width="80"
                   Height="20"
                   Content="Ver 2025/06/30"
                   Padding="0"
                   FontSize="13"
                   Foreground="#666666" />
            <TextBox x:Name="txtReleasedDate"
                     HorizontalAlignment="Left"
                     Margin="105,75,0,0"
                     VerticalAlignment="Top"
                     Width="200"
                     Height="20"
                     Text="{Binding Comment1}"
                     Padding="0"
                     VerticalContentAlignment="Center"
                     BorderBrush="#C0C0C0"
                     BorderThickness="1"
                     IsReadOnly="True" />
        </Grid>
    </Grid>
</Window>
