<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:vba_brain.UI.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="vba_brain.UI.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel">
    
    <Grid RowDefinitions="Auto,*" Background="#11111B" Margin="15">
        <!-- Control panel (Filters + Action Buttons) -->
        <Border Grid.Row="0" Background="#181825" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Filters -->
                <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Search (Customer/Code)" Foreground="#A6ADC8" FontSize="11" FontWeight="Medium"/>
                        <TextBox Text="{Binding SearchText}" PlaceholderText="Type to search..." Width="200" Height="32" VerticalContentAlignment="Center" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#313244" CornerRadius="4"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="3">
                        <TextBlock Text="Service Type" Foreground="#A6ADC8" FontSize="11" FontWeight="Medium"/>
                        <ComboBox ItemsSource="{Binding ServiceTypeFilters}" SelectedItem="{Binding SelectedServiceTypeFilter}" Width="120" Height="32" Background="#1E1E2E" BorderBrush="#313244" CornerRadius="4"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="3">
                        <TextBlock Text="Payment Flag" Foreground="#A6ADC8" FontSize="11" FontWeight="Medium"/>
                        <ComboBox ItemsSource="{Binding PaymentFlagFilters}" SelectedItem="{Binding SelectedPaymentFlagFilter}" Width="130" Height="32" Background="#1E1E2E" BorderBrush="#313244" CornerRadius="4"/>
                    </StackPanel>

                    <Button Command="{Binding ApplyFiltersCommand}" Content="Filter" Background="#313244" Foreground="#CDD6F4" Height="32" VerticalAlignment="Bottom" Padding="15,0" CornerRadius="4"/>
                    <Button Command="{Binding LoadDataCommand}" Content="Refresh" Background="#313244" Foreground="#CDD6F4" Height="32" VerticalAlignment="Bottom" Padding="15,0" CornerRadius="4"/>
                </StackPanel>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                    <Button Command="{Binding NavigateToRegisterCommand}" Content="Register New" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" Height="32" VerticalContentAlignment="Center" CornerRadius="4"/>
                    <Button Command="{Binding NavigateToEditCommand}" Content="Edit Selected" Background="#F9E2AF" Foreground="#11111B" FontWeight="Bold" Height="32" VerticalContentAlignment="Center" CornerRadius="4" IsEnabled="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Command="{Binding NavigateToPrintCommand}" Content="Print Settings" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Height="32" VerticalContentAlignment="Center" CornerRadius="4" IsEnabled="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Command="{Binding NavigateToAnalyticsCommand}" Content="Analytics" Background="#CBA6F7" Foreground="#11111B" FontWeight="Bold" Height="32" VerticalContentAlignment="Center" CornerRadius="4"/>
                    <Button Command="{Binding LogoutCommand}" Content="Logout" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" Height="32" VerticalContentAlignment="Center" CornerRadius="4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="1" Background="#181825" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="10">
            <Grid RowDefinitions="*,Auto">
                <DataGrid Grid.Row="0" 
                          ItemsSource="{Binding Items}" 
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          BorderBrush="#313244"
                          Background="#181825"
                          Foreground="#CDD6F4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Seq No" Binding="{Binding SeqNo}" Width="80"/>
                        <DataGridTextColumn Header="After Code" Binding="{Binding AfterCd}" Width="120"/>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerNm}" Width="*"/>
                        <DataGridTextColumn Header="Service Type" Binding="{Binding ServiceType}" Width="120"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding PaymentAmt, StringFormat={}{0:C}}" Width="120"/>
                        <DataGridTextColumn Header="Payment Status" Binding="{Binding PaymentFlg}" Width="130"/>
                        <DataGridTextColumn Header="District" Binding="{Binding DistrictCd}" Width="100"/>
                        <DataGridTextColumn Header="Receive Date" Binding="{Binding ReceiveDt, StringFormat={}{0:yyyy-MM-dd}}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>

                <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="4" IsVisible="{Binding IsBusy}" Foreground="#89B4FA" Background="Transparent"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
