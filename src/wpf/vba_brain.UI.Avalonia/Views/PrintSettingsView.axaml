<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:vba_brain.UI.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="vba_brain.UI.Avalonia.Views.PrintSettingsView"
             x:DataType="vm:PrintSettingsViewModel">
    
    <Grid ColumnDefinitions="*,1.2*" Background="#11111B" Margin="15" ColumnSpacing="15">
        <!-- LEFT: Print Settings Panel -->
        <Border Grid.Column="0" Background="#181825" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid RowDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Row="0" Text="Print Settings &amp; Execution" Foreground="#CDD6F4" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <StackPanel Grid.Row="1" Spacing="20">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Document Type" Foreground="#A6ADC8" FontSize="12" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding SelectedDocType}" HorizontalAlignment="Stretch" Height="36" Background="#1E1E2E" BorderBrush="#313244" CornerRadius="4"/>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="Operator Name" Foreground="#A6ADC8" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding OperatorName}" Height="36" VerticalContentAlignment="Center" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#313244" CornerRadius="4"/>
                    </StackPanel>

                    <Border Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="6" Padding="15">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Printing Engine: RDLC Local Simulation" Foreground="#CDD6F4" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="• Generates vector layouts using system fonts" Foreground="#A6ADC8" FontSize="12"/>
                            <TextBlock Text="• Exports to PDF/XLS formats instantly" Foreground="#A6ADC8" FontSize="12"/>
                            <TextBlock Text="• Logs operation audit logs in database table" Foreground="#A6ADC8" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Status log info -->
                <Border Grid.Row="2" Background="#1E1E2E" CornerRadius="6" Padding="10" Margin="0,15">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#89B4FA" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Height="40"/>
                </Border>

                <!-- Actions -->
                <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Command="{Binding CancelCommand}" Content="Back to Main" Height="38" Background="#313244" Foreground="#CDD6F4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="4"/>
                    <Button Grid.Column="1" Command="{Binding PrintCommand}" Content="Execute Print Job" Height="38" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="4" IsEnabled="{Binding !IsPrinting}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- RIGHT: Interactive Live Document Preview -->
        <Border Grid.Column="1" Background="#181825" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="Interactive Print Preview" Foreground="#CDD6F4" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <!-- Mock Page Container -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" Padding="30" CornerRadius="4">
                    <Grid RowDefinitions="Auto,Auto,*,Auto">
                        <Grid.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="Foreground" Value="#111111"/>
                            </Style>
                        </Grid.Styles>
                        <!-- Preview Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedDocType}" FontSize="20" FontWeight="Bold" LetterSpacing="1.5"/>
                                <TextBlock Text="Migration System Report" Foreground="#555555" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="PREVIEW ONLY" Foreground="#D20F39" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="Original VBA Format" Foreground="#888888" FontSize="9" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- Bill/Recipient info -->
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Bill To:" Foreground="#555555" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="VBA Migration Client Corp" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Tokyo, Shinjuku 1-2-3" Foreground="#333333" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                <TextBlock Text="Date: 2026-05-26" Foreground="#333333" FontSize="10"/>
                                <TextBlock Text="Invoice #: INV-2026-0092" Foreground="#333333" FontSize="10"/>
                            </StackPanel>
                        </Grid>

                        <!-- Mock Data Items list -->
                        <Border Grid.Row="2" BorderBrush="#EAEAEA" BorderThickness="0,1,0,1" Padding="0,15">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,100,100">
                                    <TextBlock Text="Description" FontWeight="Bold" FontSize="10" Foreground="#555555"/>
                                    <TextBlock Grid.Column="1" Text="Qty" FontWeight="Bold" FontSize="10" Foreground="#555555" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="Amount" FontWeight="Bold" FontSize="10" Foreground="#555555" HorizontalAlignment="Right"/>
                                </Grid>
                                
                                <Grid ColumnDefinitions="*,100,100">
                                    <TextBlock Text="Legacy VBA Module Refactoring Service" FontSize="11" Foreground="#333333"/>
                                    <TextBlock Grid.Column="1" Text="1" FontSize="11" Foreground="#333333" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="$15,000.00" FontSize="11" Foreground="#333333" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,100,100">
                                    <TextBlock Text="Oracle Database Setup &amp; Dapper Repository Mapping" FontSize="11" Foreground="#333333"/>
                                    <TextBlock Grid.Column="1" Text="1" FontSize="11" Foreground="#333333" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="$10,500.00" FontSize="11" Foreground="#333333" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Summary -->
                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,15,0,0">
                            <TextBlock Grid.Column="0" Text="Authorized Signature" Foreground="#888888" FontSize="10" VerticalAlignment="Bottom"/>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <Grid ColumnDefinitions="100,100">
                                    <TextBlock Text="Subtotal:" FontSize="10" Foreground="#555555" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="$25,500.00" FontSize="10" Foreground="#333333" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid ColumnDefinitions="100,100">
                                    <TextBlock Text="Tax (10%):" FontSize="10" Foreground="#555555" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="$2,550.00" FontSize="10" Foreground="#333333" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid ColumnDefinitions="100,100" Margin="0,5,0,0">
                                    <TextBlock Text="Grand Total:" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="$28,050.00" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Processing feedback -->
                <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="4" IsVisible="{Binding IsPrinting}" Foreground="#89B4FA" Background="Transparent" Margin="0,10,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
