<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:vba_brain.UI.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="vba_brain.UI.Avalonia.Views.RegistrationView"
             x:DataType="vm:RegistrationViewModel">
    
    <Grid Background="#11111B" Margin="20">
        <Border Background="#181825" BorderBrush="#313244" BorderThickness="1" CornerRadius="12" Padding="25" Width="550" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="20">
                <TextBlock Text="Register New VBA Migration Record" Foreground="#CDD6F4" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="15" ColumnSpacing="15">
                    <!-- Col 1 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
                        <TextBlock Text="After Code *" Foreground="#A6ADC8" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding AfterCd}" Height="36" VerticalContentAlignment="Center" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#313244" CornerRadius="4"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                        <TextBlock Text="Service Type" Foreground="#A6ADC8" FontSize="12" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding ServiceTypes}" SelectedItem="{Binding SelectedServiceType}" HorizontalAlignment="Stretch" Height="36" Background="#1E1E2E" BorderBrush="#313244" CornerRadius="4"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="5">
                        <TextBlock Text="District Code *" Foreground="#A6ADC8" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding DistrictCd}" Height="36" VerticalContentAlignment="Center" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#313244" CornerRadius="4"/>
                    </StackPanel>

                    <!-- Col 2 -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5">
                        <TextBlock Text="Customer Name *" Foreground="#A6ADC8" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding CustomerNm}" Height="36" VerticalContentAlignment="Center" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#313244" CornerRadius="4"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                        <TextBlock Text="Payment Amount" Foreground="#A6ADC8" FontSize="12" FontWeight="SemiBold"/>
                        <NumericUpDown Value="{Binding PaymentAmt}" Minimum="0" FormatString="C2" Height="36" Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#313244" CornerRadius="4"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="5">
                        <TextBlock Text="Payment Flag" Foreground="#A6ADC8" FontSize="12" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding PaymentFlags}" SelectedItem="{Binding SelectedPaymentFlg}" HorizontalAlignment="Stretch" Height="36" Background="#1E1E2E" BorderBrush="#313244" CornerRadius="4"/>
                    </StackPanel>

                    <!-- Row 3 Span -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Spacing="5">
                        <TextBlock Text="Receive Date" Foreground="#A6ADC8" FontSize="12" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding ReceiveDtOffset}" HorizontalAlignment="Stretch" Background="#1E1E2E" BorderBrush="#313244" CornerRadius="4"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#F38BA8" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,5"/>

                <!-- Actions -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <Button Grid.Column="0" Command="{Binding CancelCommand}" Content="Cancel" Height="40" Background="#313244" Foreground="#CDD6F4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="6"/>
                    <Button Grid.Column="1" Command="{Binding SaveCommand}" Content="Save Record" Height="40" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="6" IsEnabled="{Binding !IsBusy}"/>
                </Grid>

                <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsBusy}" Foreground="#89B4FA" Background="Transparent"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
