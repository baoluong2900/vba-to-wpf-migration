# vba_brain — optional shell/dotenv overrides
#
#   cp .env.example .env
#
# Every variable here is OPTIONAL and takes precedence over config.json.
# Resolution order (src/backend/common/config.py :: get_setting):
#   1. environment variable / .env   2. config.json   3. hard-coded default
#
# This file is a tracked template. `.env` itself is git-ignored — keep real
# secrets there. Do not commit `.env`.
# Docker Compose credentials are configured separately in infa/.env.

# ── LLM providers ─────────────────────────────────────────────────────────────
# Primary provider: Alibaba Cloud DashScope — https://dashscope.aliyuncs.com
ALIBABA_API_KEY=sk-your-dashscope-key-here
# Optional providers — leave unset if you don't use them.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MEGALLM_API_KEY=

# ── Model routing ─────────────────────────────────────────────────────────────
# Layer 2 model tier: dev | pilot | production
# L2_STAGE=dev
# DEFAULT_LLM_MODEL=qwen-max
# LAYER2_DEV_MODEL=qwen-max
# LAYER2_PILOT_MODEL=qwen-max
# LAYER3_MIGRATION_MODEL=qwen-max
# LAYER4_MIGRATION_MODEL=qwen-max
# LAYER5_DEFAULT_MODEL=qwen3-coder-480b-a35b-instruct
# LAYER5_SERVICE_MODEL=qwen3-coder-480b-a35b-instruct
# LAYER5_REPOSITORY_MODEL=qwen3-coder-480b-a35b-instruct
# LAYER5_VIEWMODEL_MODEL=qwen-plus-2025-07-28
# Remap any model alias -> real id (uppercase the id, '-' becomes '_')
# MODEL_OVERRIDE_QWEN_MAX=qwen3-coder-480b-a35b-instruct

# ── MongoDB ───────────────────────────────────────────────────────────────────
# The Docker Compose stack enables root auth, so authSource is required.
MONGO_URI=mongodb://vba_brain:CHANGE_ME@localhost:27017/vba_brain_core?authSource=admin
MONGO_DB=vba_brain_core
# Collection-name overrides (Layer 5)
# MONGO_COL_DDS=dds
# MONGO_COL_AGENT_REPO=agent_repo

# ── PostgreSQL (migration target) ─────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vba_brain
POSTGRES_USER=vba_brain
POSTGRES_PASSWORD=CHANGE_ME
# Full ADO.NET-style string; built from the parts above when unset.
# POSTGRES_CONN=Host=localhost;Port=5432;Database=vba_brain;Username=vba_brain;Password=CHANGE_ME

# ── Localization ──────────────────────────────────────────────────────────────
# SOURCE_LANGUAGE=ja
# TARGET_LANGUAGE=en

# ── gRPC gateway ──────────────────────────────────────────────────────────────
# Bind address: "localhost" (default) keeps the gateway off the network.
# GRPC_HOST=localhost
# GRPC_PORT=50051
# Shared secret. When set, every RPC needs "authorization: Bearer <token>"; the
# web console's API routes send it automatically when they see the same variable.
# GRPC_AUTH_TOKEN=
# TLS: PEM certificate chain + private key. Set both and the gateway serves TLS only.
# GRPC_TLS_CERT=
# GRPC_TLS_KEY=
# Console side: the PEM file to trust (start.py uses GRPC_TLS_CERT when this is unset),
# or GRPC_TLS=1 for a certificate signed by a public CA.
# GRPC_TLS_CA=
# GRPC_TLS=
# Where the console's API routes reach the gateway (start.py sets it from GRPC_HOST/PORT).
# GRPC_SERVER_ADDRESS=localhost:50051

# ── Web console ───────────────────────────────────────────────────────────────
# Python interpreter the API routes spawn for Layer 1 / Layer 5 scripts.
# PYTHON_BIN=python3
